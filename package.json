{
  "name": "haxmantega",
  "productName": "HaxMantega",
  "version": "1.0.0",
  "description": "Cliente de HaxBall para PC com avatar animado, temas, emojis, atalhos e limite de 90 FPS",
  "main": "main.js",
  "author": "jp",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hsa.haxmantega",
    "productName": "HaxMantega",
    "files": ["main.js", "inject.js", "mobile.js", "package.json"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
